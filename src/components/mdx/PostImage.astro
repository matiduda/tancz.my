---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

/*
 * Replaces Markdown images in MDX posts; the alt text becomes the caption.
 * The image itself gets an empty alt so screen readers don't read it twice.
 */
interface Props {
  src: ImageMetadata | string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure>
  {typeof src === "string" ? <img src={src} alt="" /> : <Image src={src} alt="" />}
  {alt && <figcaption class="text-center">{alt}</figcaption>}
</figure>
