---
import Avatar from "@/assets/avatar.jpg";
import CookieConsent from "@/components/CookieConsent.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { visiblePosts } from "@/lib/posts";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.name} — what it publishes and who writes it.`}
>
  <SiteHeader posts={allPosts} />
  <CookieConsent />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <Image
          src={Avatar}
          alt="Picture of myself"
          class="animate rounded-(--radius-md) mb-6 size-48 md:size-64 border border-border"
        />
        <p class="animate eyebrow">About</p>
        <h1 class="animate pagehead-title">{siteConfig.authorName}</h1>
        <p class="animate pagehead-description">{siteConfig.about}</p>
      </header>

      <div class="animate prose">
        <h2>Get in touch</h2>
        <p>
          Questions, corrections, and requests are welcome through the <a href="/contact/"
            >contact page</a
          >.
        </p>
        {
          siteConfig.email && (
            <p>
              You can also email <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>{" "}
              directly.
            </p>
          )
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
