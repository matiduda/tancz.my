---
import CookieConsent from "@/components/CookieConsent.astro";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { authorSlug, getAllAuthors, visiblePosts, type Post } from "@/lib/posts";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allPosts = visiblePosts(await getCollection("posts"));
  return getAllAuthors(allPosts).map((author) => ({
    params: { author: author.slug },
    props: { author, allPosts },
  }));
}

interface Props {
  author: { slug: string; name: string; role: string; posts: Post[] };
  allPosts: Post[];
}

const { author, allPosts } = Astro.props;
const posts = visiblePosts(allPosts).filter(
  (post) => authorSlug(post.data.author.name) === author.slug,
);
---

<BaseLayout
  title={author.name}
  description={`Posts by ${author.name}, ${author.role}, on ${siteConfig.name}.`}
>
  <SiteHeader posts={allPosts} />
  <CookieConsent />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="animate eyebrow">Author</p>
        <h1 class="animate pagehead-title">{author.name}</h1>
        <p class="animate pagehead-description">
          {author.role} &middot; {posts.length}
          {posts.length === 1 ? " post" : " posts"}
        </p>
      </header>

      <div class="feed">
        {posts.map((post) => <PostCard post={post} />)}
      </div>

      <a href="/author/" class="btn btn-outline btn-block mt-16">All authors</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
