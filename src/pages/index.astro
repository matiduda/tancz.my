---
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import PostCard from "@/components/PostCard.astro";
import ShaderShowcase from "@/components/ShaderShowcase.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryHref, getCategoryList, getFeatured, visiblePosts } from "@/lib/posts";
import { getCollection } from "astro:content";

const allPosts = visiblePosts(await getCollection("posts"));
const [latest, ...rest] = allPosts;
const feed = rest.slice(0, 4);
const featured = getFeatured(allPosts, 4).filter((post) => post.id !== latest?.id);
const categoryList = getCategoryList(allPosts);
const hasMore = rest.length > feed.length;
---

<BaseLayout>
  <SiteHeader posts={allPosts} />
  <ShaderShowcase />
  <main id="content" class="outer">
    <div class="inner">
      <h1 class="sr-only">{siteConfig.name} — {siteConfig.tagline}</h1>

      <div
        class="grid gap-(--space-section) lg:grid-cols-[minmax(0,4fr)_minmax(0,2fr)] lg:gap-12 pt-10 md:pt-14"
      >
        <section aria-labelledby="more-posts">
          <h2 id="more-posts" class="section-title">Blog posts</h2>
          {
            feed.length > 0 ? (
              <div class="feed">
                {feed.map((post) => (
                  <PostCard post={post} />
                ))}
              </div>
            ) : (
              <p class="text-muted-foreground">More posts are coming soon.</p>
            )
          }

          {
            hasMore && (
              <a href="/posts/" class="btn btn-outline btn-block mt-16">
                See all posts
              </a>
            )
          }
        </section>

        <aside class="sidebar">
          <section aria-labelledby="about-heading">
            <h2 id="about-heading" class="section-title">About</h2>
            <p class="mt-2 text-pretty text-sm leading-relaxed text-muted-foreground">
              {siteConfig.about}
            </p>
            <div class="mt-7 border-t border-border pt-6">
              <NewsletterSignup />
            </div>
          </section>

          {
            featured.length > 0 && (
              <section aria-labelledby="featured-heading">
                <h2 id="featured-heading" class="section-title">
                  Featured
                </h2>
                <div class="grid gap-7">
                  {featured.map((post) => (
                    <PostCard post={post} variant="compact" headingLevel="h3" />
                  ))}
                </div>
              </section>
            )
          }

          {
            categoryList.length > 0 && (
              <section aria-labelledby="categories-heading">
                <h2 id="categories-heading" class="section-title">
                  Categories
                </h2>
                <ul class="grid gap-4">
                  {categoryList.map((category) => (
                    <li>
                      <a
                        href={categoryHref(category.name)}
                        class="link-title flex items-center justify-between gap-3"
                      >
                        <span class="link-title__text text-base font-semibold tracking-tight">
                          {category.name}
                        </span>
                        <span class="pill shrink-0">
                          {category.count} {category.count === 1 ? "post" : "posts"}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            categoryList.length > 0 && (
              <section aria-labelledby="categories-heading">
                <h2 id="categories-heading" class="section-title">
                  Categories
                </h2>
                <ul class="grid gap-4">
                  {categoryList.map((category) => (
                    <li>
                      <a
                        href={categoryHref(category.name)}
                        class="link-title flex items-center justify-between gap-3"
                      >
                        <span class="link-title__text text-base font-semibold tracking-tight">
                          {category.name}
                        </span>
                        <span class="pill shrink-0">
                          {category.count} {category.count === 1 ? "post" : "posts"}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </aside>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
