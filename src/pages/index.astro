---
import CookieConsent from "@/components/CookieConsent.astro";
import PostCard from "@/components/PostCard.astro";
import Recommendation from "@/components/Recommendation.astro";
import ShaderShowcase from "@/components/ShaderShowcase.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { recommendations, siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryHref, getCategoryList, visiblePosts } from "@/lib/posts";
import { getCollection } from "astro:content";

const allPosts = visiblePosts(await getCollection("posts"));
const feed = allPosts.slice(0, 4);
const categoryList = getCategoryList(allPosts);
const hasMore = allPosts.length > feed.length;
---

<BaseLayout>
  <SiteHeader posts={allPosts} />
  <CookieConsent />
  <ShaderShowcase />
  <main id="content" class="outer">
    <div class="inner">
      <h1 class="sr-only">{siteConfig.name} — {siteConfig.tagline}</h1>

      <div
        class="grid gap-(--space-section) lg:grid-cols-[minmax(0,4fr)_minmax(0,2fr)] lg:gap-10.5 pt-10 md:pt-14"
      >
        <section aria-labelledby="more-posts">
          <h2 id="more-posts" class="section-title">Blog posts</h2>
          {
            feed.length > 0 ? (
              <div class="feed">
                {feed.map((post) => (
                  <PostCard post={post} variant="compact" />
                ))}
              </div>
            ) : (
              <p class="text-muted-foreground">More posts are coming soon.</p>
            )
          }

          {
            hasMore && (
              <a href="/posts/" class="btn btn-outline btn-block mt-16">
                See all posts
              </a>
            )
          }
        </section>

        <aside class="sidebar">
          {
            categoryList.length > 0 && (
              <section aria-labelledby="categories-heading">
                <h2 id="categories-heading" class="section-title">
                  Categories
                </h2>
                <ul class="grid gap-4">
                  {categoryList.map((category) => (
                    <li>
                      <a
                        href={categoryHref(category.name)}
                        class="animate link-title flex items-center justify-between gap-3"
                      >
                        <span class="link-title__text text-base font-semibold tracking-tight">
                          {category.name}
                        </span>
                        <span class="pill shrink-0">
                          {category.count} {category.count === 1 ? "post" : "posts"}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            categoryList.length > 0 && (
              <section aria-labelledby="recommended-heading">
                <h2 id="recommended-heading" class="section-title">
                  Recommended
                </h2>
                <p class="animate mt-2 text-pretty text-sm leading-relaxed text-muted-foreground">
                  {siteConfig.recommended}
                </p>
                <div class="mt-8 space-y-6">
                  {recommendations.map((recommendation) => (
                    <Recommendation recommendation={recommendation} />
                  ))}
                </div>
              </section>
            )
          }
        </aside>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
